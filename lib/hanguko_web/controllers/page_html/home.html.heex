<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section id="hero" class="py-8 sm:py-14">
    <p lang="ko" class="text-sm font-semibold tracking-widest text-primary">한국어 공부</p>
    <h1 class="mt-3 max-w-2xl text-4xl font-bold tracking-tight text-balance sm:text-5xl">
      Learn Korean, one card at a time.
    </h1>
    <p class="mt-5 max-w-xl text-lg text-base-content/70">
      Start by learning to read Hangeul, then build everyday vocabulary and the phrases you'll use
      in your first conversations.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <.link
        navigate={~p"/hangeul"}
        id="cta-hangeul"
        class="inline-flex items-center gap-2 rounded-field bg-primary px-5 py-2.5 font-semibold text-primary-content shadow-sm transition hover:brightness-110 active:scale-[0.98]"
      >
        Start with Hangeul <.icon name="hero-arrow-right" class="size-4" />
      </.link>
      <.link
        :if={is_nil(@current_scope)}
        navigate={~p"/users/register"}
        id="cta-register"
        class="inline-flex items-center rounded-field border border-base-300 bg-base-100 px-5 py-2.5 font-semibold transition hover:border-base-content/30"
      >
        Create a free account
      </.link>
    </div>
  </section>

  <section id="features" class="grid gap-4 sm:grid-cols-3">
    <.link
      navigate={~p"/hangeul"}
      class="group rounded-box border border-base-300 bg-base-100 p-6 transition hover:-translate-y-0.5 hover:shadow-md"
    >
      <div lang="ko" class="text-4xl font-medium text-primary">ㄱ ㅏ 가</div>
      <h2 class="mt-4 font-semibold group-hover:text-primary">Hangeul</h2>
      <p class="mt-1 text-sm text-base-content/70">
        All 40 letters, how they combine into syllables, and how each one sounds.
      </p>
    </.link>
    <.link
      navigate={~p"/decks?kind=vocab"}
      class="group rounded-box border border-base-300 bg-base-100 p-6 transition hover:-translate-y-0.5 hover:shadow-md"
    >
      <div lang="ko" class="text-4xl font-medium text-secondary">사과</div>
      <h2 class="mt-4 font-semibold group-hover:text-secondary">Vocabulary</h2>
      <p class="mt-1 text-sm text-base-content/70">
        Themed decks of beginner words: numbers, family, food, time, places and more.
      </p>
    </.link>
    <.link
      navigate={~p"/decks?kind=phrases"}
      class="group rounded-box border border-base-300 bg-base-100 p-6 transition hover:-translate-y-0.5 hover:shadow-md"
    >
      <div lang="ko" class="text-4xl font-medium text-accent">감사합니다</div>
      <h2 class="mt-4 font-semibold group-hover:text-accent">Phrases</h2>
      <p class="mt-1 text-sm text-base-content/70">
        Greetings, thanks, apologies and asking for help, with the right level of politeness.
      </p>
    </.link>
  </section>
</Layouts.app>
